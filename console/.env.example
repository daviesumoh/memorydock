# Copy to console/.env.local. None of these is a secret except the cookie password.

# AuthKit client id of the WorkOS environment (Staging for local work).
WORKOS_CLIENT_ID=
# Encrypts the session cookie; at least 32 characters (openssl rand -base64 32).
WORKOS_COOKIE_PASSWORD=
# Must match a redirect URI registered in WorkOS exactly.
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/callback
# Gateway base URL; the proxy forwards /api/gateway/v1/* to <GATEWAY_URL>/v1/*.
GATEWAY_URL=http://127.0.0.1:8000
