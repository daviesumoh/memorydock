{
  "name": "memorydock-console",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "gen:api": "openapi-typescript ../docs/openapi.json -o lib/api/schema.d.ts",
    "gen:api:check": "openapi-typescript ../docs/openapi.json -o lib/api/schema.d.ts --check",
    "predev": "msw init public --no-save"
  },
  "dependencies": {
    "@tanstack/react-query": "5.107.1",
    "@workos-inc/authkit-nextjs": "4.6.3",
    "@workos-inc/node": "^12",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.73.0",
    "next": "16.4.6",
    "openapi-fetch": "^0.17.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "jsdom": "^31.0.1",
    "msw": "^3.0.5",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "5.1.0"
  }
}
