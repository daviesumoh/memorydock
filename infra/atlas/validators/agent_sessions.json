{
  "$jsonSchema": {
    "bsonType": "object",
    "required": [
      "_id",
      "tenant_id",
      "user_id",
      "client",
      "client_id",
      "client_session_id",
      "status",
      "capture_paused",
      "started_at",
      "last_seen_at",
      "created_at",
      "updated_at"
    ],
    "properties": {
      "_id": {
        "bsonType": "string",
        "pattern": "^ses_"
      },
      "tenant_id": {
        "bsonType": "string"
      },
      "user_id": {
        "bsonType": "string",
        "pattern": "^usr_"
      },
      "client": {
        "enum": [
          "claude-code",
          "codex",
          "claude-app",
          "chatgpt",
          "console",
          "other"
        ]
      },
      "client_id": {
        "bsonType": "string"
      },
      "client_session_id": {
        "bsonType": "string",
        "maxLength": 200
      },
      "machine_id": {
        "bsonType": [
          "string",
          "null"
        ]
      },
      "repo_id": {
        "bsonType": [
          "string",
          "null"
        ]
      },
      "project_id": {
        "bsonType": [
          "string",
          "null"
        ]
      },
      "branch": {
        "bsonType": [
          "string",
          "null"
        ]
      },
      "model": {
        "bsonType": [
          "string",
          "null"
        ]
      },
      "status": {
        "enum": [
          "active",
          "paused",
          "revoked",
          "ended"
        ]
      },
      "intent": {
        "bsonType": [
          "string",
          "null"
        ],
        "maxLength": 500
      },
      "intent_updated_at": {
        "bsonType": [
          "date",
          "null"
        ]
      },
      "started_at": {
        "bsonType": "date"
      },
      "last_seen_at": {
        "bsonType": "date"
      },
      "ended_at": {
        "bsonType": [
          "date",
          "null"
        ]
      },
      "revoked_by": {
        "bsonType": [
          "string",
          "null"
        ]
      },
      "revoke_reason": {
        "bsonType": [
          "string",
          "null"
        ]
      },
      "capture_paused": {
        "bsonType": "bool"
      },
      "created_at": {
        "bsonType": "date"
      },
      "updated_at": {
        "bsonType": "date"
      }
    }
  }
}
