# Runtime
ENV=dev                                  # dev or prod; dev refuses the shared database
GATEWAY_BASE_URL=http://127.0.0.1:8000   # public base URL; the MCP resource is <base>/mcp
CONSOLE_ORIGIN=http://localhost:3000     # allowed CORS origin for the console
EXTENSION_ORIGIN=                        # chrome-extension://<id>, allowed CORS origin for the extension
LOG_LEVEL=INFO                           # DEBUG, INFO, WARNING or ERROR
GIT_SHA=                                 # set by the deploy build; shown by /readyz

# Atlas
MONGODB_URI=                             # gateway database user (md_gateway)
MONGODB_URI_WORKER=                      # worker database user (md_worker)
MONGODB_URI_ADMIN=                       # setup scripts and integration tests only; never deployed
MONGODB_DB=memorydock_dev_<handle>       # your own database; prod uses memorydock
AUTOEMBED_MODEL=voyage-4                 # Automated Embedding model; changing it means a new vector index
