# Runtime
ENV=dev                                  # dev or prod; dev refuses the shared database

# Atlas
MONGODB_URI=                             # gateway database user (md_gateway)
MONGODB_URI_WORKER=                      # worker database user (md_worker)
MONGODB_URI_ADMIN=                       # setup scripts and integration tests only; never deployed
MONGODB_DB=memorydock_dev_<handle>       # your own database; prod uses memorydock
