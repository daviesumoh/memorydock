# Copy to clients/extension/.env.local. These are compiled into the extension; none is a secret.

# Gateway base URL; added to host permissions.
GATEWAY_URL=http://127.0.0.1:8000
# AuthKit domain of the WorkOS environment; added to host permissions for sign-in.
AUTHKIT_DOMAIN=
# Console URL the popup links to.
CONSOLE_URL=http://localhost:3000
